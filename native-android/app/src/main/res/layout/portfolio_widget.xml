<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="INVESTMENT OS · v2" android:textSize="11sp" android:textStyle="bold" android:textColor="#8EBCFF"/>

    <TextView android:id="@+id/total" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Import snapshot" android:textSize="25sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="3dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/asset_left" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="운용 —
퇴직 —" android:textSize="10sp" android:textColor="#D5E1EF"/>
        <TextView android:id="@+id/asset_right" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="ISA —
임직원 —" android:textSize="10sp" android:textColor="#D5E1EF"/>
    </LinearLayout>

    <TextView android:id="@+id/top_exposure" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Top exposure: —" android:textSize="10sp" android:textColor="#A9BDD5"
        android:singleLine="true" android:ellipsize="end" android:layout_marginTop="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/us_market" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="US · —" android:textStyle="bold" android:textSize="11sp" android:textColor="#F4C76A"/>
        <TextView android:id="@+id/kr_market" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="KR · —" android:textStyle="bold" android:textSize="11sp" android:textColor="#F4C76A"/>
    </LinearLayout>

    <TextView android:id="@+id/macro" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="USD/KRW — · US10Y —" android:textSize="10sp" android:textColor="#D5E1EF"
        android:singleLine="true" android:ellipsize="end" android:layout_marginTop="4dp"/>

    <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Portfolio local · Market pending" android:textSize="9sp" android:textColor="#8298B3"
        android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp"/>
</LinearLayout>